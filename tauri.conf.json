{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wardogs AutoClicker 4.20",
  "version": "4.20.0",
  "identifier": "io.github.z0157.wardogs-autoclicker",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wardogs AutoClicker 4.20",
        "width": 460,
        "height": 780,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0d09"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
